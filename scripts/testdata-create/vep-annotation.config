// Config for wtsi-hgi/nf_vep_annotation, run via scripts/testdata-create/7_run_vep_annotation.
//
// The pipeline's own defaults target Sanger's farm: `-profile sanger` (LSF executor via
// nf-core/configs), a `.sif` resolved from a Sanger-local path for RUN_VEP, and a
// `singularity.runOptions = '--bind /lustre'` bind mount - none of which exist off-farm.
// This config runs locally instead (matching how sarek-vc.config overrides Sarek's
// defaults for 3_run_sarek_vc): no explicit `executor` block is needed since Nextflow
// defaults to `local` unless a profile says otherwise and we don't pass `-profile sanger`;
// docker/singularity enablement below picks whichever container engine is actually
// available on the machine this runs on.
//
// max_cpus caps conf/base.config's check_max() calls, which otherwise only clamp against
// this value (default 64) rather than the local machine's actual core count - e.g.
// NO_G_VCF requests 10 cpus on its first attempt, which the local executor rejects outright
// if it exceeds what Nextflow auto-detected as available. 8 matches sarek-vc.config's
// `executor { cpus = 8 }`; lower if the machine running this has fewer cores.
//
// Every bcftools/htslib-based module's container ternary picks 'biocontainers/<tool>:<tag>'
// under Docker - but biocontainers stopped publishing new builds to that Docker Hub
// namespace years ago, so that tag doesn't exist there. Overridden below to the
// equivalent quay.io/biocontainers image at the same tag (verified both tags exist via
// quay.io's API) for every process that needs it. This bare, scheme-less string works
// under either engine: Nextflow treats it as a Docker reference regardless, pulling it
// directly under Docker or auto-converting it via `singularity pull docker://...` under
// Singularity - so switching docker.enabled/singularity.enabled above doesn't require
// touching these. NORM_VCF_WITH_G/NORM_VCF_WITH_G_LEFT_ALIGN are the `as`-aliased names
// workflows/run_vep_annotation.nf gives NORM_VCF/NORM_VCF_LEFT_ALIGN - included in case
// Nextflow's withName selector matches the alias rather than the base process name.

docker {
  enabled = false
}

singularity {
  enabled = true
  // The pipeline's own nextflow.config unconditionally sets runOptions = '--bind /lustre'
  // (a Sanger-farm-specific bind mount): every lustre-hosted resource path (VEP cache,
  // reference FASTAs, etc.) is visible inside every container as a side effect of that one
  // wholesale bind, since RUN_VEP's --dir_cache/--fasta/--dir_plugins values are plain
  // strings baked into the VEP command line (not proper Nextflow `path` inputs), so
  // Nextflow never stages or auto-binds them itself. /lustre doesn't exist off-farm, so we
  // bind our own equivalent resource root instead - but the fully-resolved real path
  // (WORKDIR_REAL, exported by 7_run_vep_annotation), not $WORKDIR's own symlinked path:
  // $WORKDIR chains to a separate mounted volume outside $HOME, and Nextflow's default
  // singularity autoMounts already binds $HOME as a whole, so binding the symlinked path
  // would nest inside that already-bound tree at the same dangling symlink - an ambiguous,
  // shadowed bind. The resolved real path has no such conflict.
  runOptions = "--bind ${System.getenv('WORKDIR_REAL')}"
}

params {
  max_cpus = 8
}

process {
  withName: 'BCFTOOLS_ALL_VEP|BCFTOOLS_ANNOTATE|SPLIT_VCF_BED|BCFTOOLS_SPLIT_VEP|GET_CSQ_HEADER|BCFTOOLS_EXTRACT_CSQ|NORM_VCF|NORM_VCF_WITH_G|NORM_VCF_LEFT_ALIGN|NORM_VCF_WITH_G_LEFT_ALIGN|NO_G_VCF|SPLIT_VCF|VCF_PREPROCESS' {
    container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
  }

  withName: BGZIP {
    container = 'quay.io/biocontainers/htslib:1.23.1--h633afcb_0'
  }

  withName: RUN_VEP {
    container = 'ensemblorg/ensembl-vep:release_115.2'
  }
}
