// SAREK config for variant calling on the fixed testdata.consts sample set.
//
// Nextflow configs cannot `source` a bash file, so the values below must be kept
// in sync by hand with scripts/testdata-create/testdata.consts. In particular:
//   - `input`     must match testdata.consts' SAREK_SAMPLESHEET
//   - `intervals` must match testdata.consts' EXOME_TARGETS_BED
//   - `outdir`    must match testdata.consts' SAREK_OUTDIR
// (DATASET_NAME is referenced by the caller, 3_run_sarek_vc, for log/trace file names.)

params {
  // Path to your samplesheet CSV - must match testdata.consts' SAREK_SAMPLESHEET.
  input = 'workdir/testdata_1000genomes_v2.sarek-samplesheet.csv'

  // Define the steps you want to run
  step = 'variant_calling'

  // Run joint calling step for cohort
  wes                     = false
  nucleotides_per_second  = 5000     // Smaller intervals than default - reduce task time and memory usage
  joint_germline          = true

  // Define the tools for variant calling and annotation
  tools = 'haplotypecaller'

  // Set reference genome
  genome = 'GATK.GRCh38'
  intervals = '../../artifacts/public-dataset-build/hg38_exome_v2.0.2_targets_sorted_validated.re_annotated.padded50.bed.gz'

  // Must match testdata.consts' SAREK_OUTDIR.
  outdir = 'workdir/sarek.outdir'

}

executor {
    name = "local"
    cpus = 8
    memory = 48.GB
}

def annotations = '--annotation AS_QualByDepth -A AS_ReadPosRankSumTest -A AS_MappingQualityRankSumTest -A AS_StrandOddsRatio'

process {

  maxRetries = 1

  withName: 'GATK4_HAPLOTYPECALLER' {
        cpus   = 2                    // With bigger number uses CPU unefficiently
        memory = { 3.GB * task.attempt }
        time   = { 24.h }
        ext.args   = '-ERC GVCF' + ' ' + annotations
    }

  withName: 'GATK4_GENOMICSDBIMPORT' {
        cpus   = 1
        memory = { 8.GB * task.attempt }  // The memory requrements depends on number of samples
        time   = { 12.h }
    }

  withName: 'GATK4_GENOTYPEGVCFS' {
        cpus   = 1
        memory = { 8.GB * task.attempt } // The memory requrements depends on number of samples
        time   = { 12.h }
        ext.args   = annotations
    }

  // override bug in https://github.com/nf-core/sarek/issues/918
  withName:VCFTOOLS_TSTV_COUNT {
    errorStrategy = 'ignore'
  }
}
